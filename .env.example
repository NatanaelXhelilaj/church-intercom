# Church Intercom — deployment configuration.
#
#   cp .env.example .env
#
# then fill in the three REQUIRED values below. The stack refuses to start
# without them rather than falling back to insecure defaults.

# ============================================================ REQUIRED

# Database password. Any long random string; you never type it by hand.
#   openssl rand -base64 24
DB_PASSWORD=

# Signs session cookies. Changing it logs everyone out.
#   openssl rand -hex 32
SESSION_SECRET=

# Creates the first administrator on first boot only. Once that account
# exists this value is ignored, so you may blank it afterwards.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# ============================================================ NETWORK

PORT=3443

# HTTPS is effectively mandatory. Browsers refuse microphone access on
# non-HTTPS origins other than localhost, so over plain HTTP no phone or
# tablet on the LAN can join a room at all.
HTTPS=true

# Leave ANNOUNCED_IP blank to auto-detect this machine's LAN address. Set it
# only if the machine has more than one network interface and the wrong one
# gets picked.
ANNOUNCED_IP=

# WebRTC media ports. Must be open in the host firewall (UDP).
RTP_PORT_MIN=40000
RTP_PORT_MAX=40199

# ============================================================ ROOMS

# Comma-separated. Edit freely; the web client reads this list from the server.
ROOMS=Video Production,media,bashkepunetoret,room4,room5,room6,room7,room8

# ============================================================ AUDIO

# Each hardware input becomes an independent mono feed that users subscribe to
# individually. Find your interface with:
#
#   docker compose exec app arecord -l
#
# and read the card/device numbers into AUDIO_CAPTURE_DEVICE as hw:CARD,DEVICE.
# Prefer an explicit hw: device over "default" — the latter routes through
# dmix and adds latency.

AUDIO_CAPTURE_ENABLED=true
AUDIO_CAPTURE_DEVICE=hw:1,0
AUDIO_CAPTURE_CHANNELS=2
AUDIO_CHANNEL_1_NAME=Program
AUDIO_CHANNEL_2_NAME=Talkback

# Lets an admin send their microphone to the server's physical output.
AUDIO_PLAYBACK_ENABLED=true
AUDIO_PLAYBACK_DEVICE=hw:1,0
# ffmpeg output device: "alsa" on Linux, "audiotoolbox" on a Mac.
AUDIO_PLAYBACK_FORMAT=alsa

# The capture and playback devices above are only the defaults. An admin can
# repoint either one at runtime from the "Server Audio Interface" panel, and the
# choice is remembered here — outside .env, which is hand-edited and read-only
# on a locked-down appliance image.
AUDIO_SETTINGS_PATH=data/audio-devices.json

# Numeric gid of the host's `audio` group — 29 on Debian and Ubuntu. Check with
# `getent group audio`. Wrong value means the container cannot open /dev/snd.
AUDIO_GID=29

# Verbose ffmpeg and mediasoup logging. Leave off in normal use: it writes a
# lot, and writes cost flash endurance.
DEBUG_AUDIO=false

# ============================================================ DATABASE

DB_NAME=church_intercom
DB_USER=intercom

# Nightly pg_dump retention, in days. Dumps land in ./backups.
BACKUP_RETENTION_DAYS=14

# Host-side port for Postgres (loopback only). Change if the host already
# runs a Postgres on 5432.
DB_PUBLISHED_PORT=5432
