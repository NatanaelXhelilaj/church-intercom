# Docker Environment Configuration
# Copy this file to .env before running docker-compose

# Server configuration
PORT=3000
HTTPS=false

# Public IP - IMPORTANT: Set this to your server's public IP or hostname
# For local testing, use 127.0.0.1 or localhost
# For production, use your server's public IP address
ANNOUNCED_IP=127.0.0.1

# Bitrate controls
MAX_INCOMING_BITRATE=800000
INITIAL_AVAILABLE_BITRATE=1000000

# Database password
# IMPORTANT: Change this to a strong password in production!
DB_PASSWORD=postgres

# Session secret
# IMPORTANT: Generate a strong random secret in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-secret-in-production

# Optional: Server audio streaming (House Feed)
# Uncomment and configure for your environment
#SERVER_AUDIO_COMMAND=ffmpeg -hide_banner -loglevel error -f alsa -i default -ac 2 -ar 48000 -acodec libopus -b:a 128k -payload_type {payloadType} -ssrc {ssrc} -f rtp rtp://{ip}:{port}
#SERVER_AUDIO_NAME=House Feed

# Optional: Admin-to-Server audio streaming
# Uncomment and configure for your environment
#ADMIN_TO_SERVER_COMMAND=ffmpeg -hide_banner -loglevel error -protocol_whitelist file,rtp,udp -i rtp://0.0.0.0:{port}?localrtcpport={port} -f alsa default
