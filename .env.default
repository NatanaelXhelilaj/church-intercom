# Default environment configuration for the Church Intercom server.
# These values are safe to commit and serve as fallbacks when .env overrides
# are not provided. Copy this file to .env and adjust it for local deployments.

PORT=3000
HTTPS=false

# Absolute paths to your TLS key/certificate files when HTTPS is enabled.
# Sample development TLS assets live in certs/ssl_key.pem and certs/ssl_cert.pem.
# Update these paths to point at your deployment-specific key/cert when enabling HTTPS.
SSL_KEY_PATH=certs/ssl_key.pem
SSL_CERT_PATH=certs/ssl_cert.pem
# Optional chain certificate for HTTPS deployments.
SSL_CA_PATH=

# Public IP address or hostname that clients should use to reach this server.
ANNOUNCED_IP=127.0.0.1

# Bitrate controls for mediasoup WebRTC transports (values in bits per second).
MAX_INCOMING_BITRATE=800000
INITIAL_AVAILABLE_BITRATE=1000000

# PostgreSQL database connection settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=church_intercom
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# Session configuration
# IMPORTANT: Change this to a strong random secret in production!
SESSION_SECRET=change-this-secret-in-production

# Admin-to-server audio streaming configuration
# Command to play audio received from admin to server's audio output device.
# The server will receive RTP audio from the admin's microphone and play it through
# the server's speakers/headphone jack using this command.
# Placeholders: {ip}, {port}, {payloadType}, {ssrc} are replaced at runtime.
#
# Example for Linux (ALSA):
# ADMIN_TO_SERVER_COMMAND="ffmpeg -hide_banner -loglevel error -protocol_whitelist file,rtp,udp -i rtp://0.0.0.0:{port}?localrtcpport={port} -f alsa default"
#
# Example for macOS (CoreAudio via avfoundation):
# ADMIN_TO_SERVER_COMMAND="ffmpeg -hide_banner -loglevel error -protocol_whitelist file,rtp,udp -i rtp://0.0.0.0:{port}?localrtcpport={port} -f avfoundation -audio_device_index 0 -"
#
# Note: The command should listen on the port that will be provided by mediasoup
ADMIN_TO_SERVER_COMMAND=
