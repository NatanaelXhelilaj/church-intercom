{
  "name": "church-intercom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development BYPASS_AUTH=true node server.js",
    "build": "npm run build:vendor",
    "build:vendor": "esbuild node_modules/mediasoup-client/lib/index.js --bundle --minify --format=iife --global-name=mediasoupClient --platform=browser --define:process.env.NODE_ENV=\\\"production\\\" --outfile=public/vendor/mediasoup-client.js",
    "test:signalling": "node test/signalling.test.mjs",
    "test:admin-rule": "node test/admin-rule.test.mjs",
    "test:devices": "node test/devices.test.mjs"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "connect-pg-simple": "^9.0.1",
    "cookie-parser": "^1.4.6",
    "express": "^4.18.2",
    "express-session": "^1.18.0",
    "mediasoup": "^3.19.6",
    "mediasoup-client": "^3.12.0",
    "pg": "^8.11.3",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "socket.io-client": "^4.7.2"
  }
}
