.git
.gitignore
node_modules
npm-debug.log
*.log

# Secrets and TLS material are mounted at runtime, never baked into the image.
.env
.env.*
!.env.example
certs/
backups/

# Docs and host tooling are not needed inside the container.
*.md
deploy/
.claude
.vscode
.idea
.DS_Store

# Rebuilt during the image build.
public/vendor/
