# Environment for the church-intercom systemd service.
# Installed to /etc/church-intercom.env. Edit there, then:
#   sudo systemctl restart church-intercom
#
# Precedence inside server.js is: this file > the repo's .env > .env.default.

# No PostgreSQL is installed on this appliance, so the server runs with the
# in-memory session store and no login wall. Install PostgreSQL and drop this
# line to turn authentication back on.
BYPASS_AUTH=true

HTTPS=true
PORT=3443
NODE_ENV=production

# Generated at install time. Only used when BYPASS_AUTH is off.
SESSION_SECRET=replace-me

# Interpreter to run the server with. /usr/bin/node is the system Node the
# native modules (mediasoup, bcrypt, @discordjs/opus) were built against --
# switching to the nvm build means rebuilding node_modules first.
NODE_BIN=/usr/bin/node

# Leave unset to detect the LAN address at every boot, which is what you want
# on DHCP. Set it only for a static address or a NAT'd deployment.
#ANNOUNCED_IP=192.168.1.100
