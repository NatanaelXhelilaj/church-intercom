# Appliance-level environment for the church-intercom systemd service.
# Installed to /etc/church-intercom.env. Edit there, then:
#   sudo systemctl restart church-intercom
#
# Application configuration does NOT live here -- it lives in
# /home/ubuntu/church-intercom/.env, which config.js reads directly and which
# .env.example documents. Only settings that are a property of *this machine*
# rather than of the app belong in this file.
#
# Note that anything set here wins over .env: systemd puts it in the real
# environment, and config.js gives the real environment precedence.

# Interpreter to run the server with. The native modules (mediasoup) are built
# against this Node during `npm ci`, so changing it means reinstalling
# node_modules.
NODE_BIN=/usr/bin/node

# Normally left unset: the start wrapper works out the LAN address from the
# default route at every boot, which is what you want on DHCP. Set it only to
# pin a specific interface on a multi-homed box, or for a NAT'd deployment.
#ANNOUNCED_IP=192.168.1.100
